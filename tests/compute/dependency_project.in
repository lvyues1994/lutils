cmake_minimum_required(VERSION 3.21)
project(kernel_dependency_test LANGUAGES CXX)
add_executable(lutils-kernelc IMPORTED GLOBAL)
set_property(TARGET lutils-kernelc PROPERTY IMPORTED_LOCATION "@TOOL@")
add_library(runtime INTERFACE)
add_library(lutils::compute ALIAS runtime)
target_include_directories(runtime INTERFACE "@ROOT@/core/include" "@ROOT@/compute/kernel/include" "@ROOT@/compute/runtime/include")
target_compile_features(runtime INTERFACE cxx_std_17)
add_library(lutils_development INTERFACE)
set(LUTILS_GLSLANG "@GLSLANG@")
set(LUTILS_SPIRV_VAL "@SPIRV_VAL@")
include("@ROOT@/cmake/LutilsKernel.cmake")
add_compile_definitions(DIRECTORY_FACTOR=2u "$<$<CONFIG:Release>:CONFIG_FACTOR=3u>")
add_compile_options(-UUNSET_FACTOR -DOPTION_FACTOR=4u)
lutils_add_kernel(fixture NAME fixture SOURCE kernel.cpp ENTRY fixture::run INCLUDE_DIRS "private headers" DEFINITIONS FACTOR=1u)
if(REJECT_LANGUAGE_PROFILE)
    target_compile_definitions(fixture PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:LANGUAGE_FACTOR=1>")
endif()
add_executable(probe main.cpp)
target_compile_definitions(probe PRIVATE FACTOR=99u)
target_link_libraries(probe PRIVATE fixture)
