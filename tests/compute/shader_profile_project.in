cmake_minimum_required(VERSION 3.21)
project(shader_profile_test LANGUAGES CXX)
add_executable(lutils-kernelc IMPORTED GLOBAL)
set_property(TARGET lutils-kernelc PROPERTY IMPORTED_LOCATION "@TOOL@")
set(LUTILS_BUILD_KERNELC OFF)
set(LUTILS_ENABLE_VULKAN OFF)
add_subdirectory("@ROOT@" lutils)
set(LUTILS_GLSLANG "@GLSLANG@")
set(LUTILS_SPIRV_VAL "@SPIRV_VAL@")
include("@ROOT@/cmake/LutilsKernel.cmake")
add_subdirectory(shader)
add_executable(probe main.cpp)
target_link_libraries(probe PRIVATE fixture lutils::compute_cpu)
