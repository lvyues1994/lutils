cmake_minimum_required(VERSION 3.21)
project(shader_profile_test LANGUAGES CXX)
add_executable(lutils-kernelc IMPORTED GLOBAL)
set_property(TARGET lutils-kernelc PROPERTY IMPORTED_LOCATION "@TOOL@")
add_library(runtime STATIC "@ROOT@/compute/runtime/src/Runtime.cpp" "@ROOT@/compute/backends/cpu/Cpu.cpp")
add_library(lutils::compute ALIAS runtime)
target_include_directories(runtime PUBLIC "@ROOT@/core/include" "@ROOT@/compute/kernel/include" "@ROOT@/compute/runtime/include")
target_compile_features(runtime PUBLIC cxx_std_17)
add_library(lutils_development INTERFACE)
set(LUTILS_GLSLANG "@GLSLANG@")
set(LUTILS_SPIRV_VAL "@SPIRV_VAL@")
include("@ROOT@/cmake/LutilsKernel.cmake")
add_subdirectory(shader)
add_executable(probe main.cpp)
target_link_libraries(probe PRIVATE fixture)
