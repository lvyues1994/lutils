@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/lutilsCoreTargets.cmake")
set_property(TARGET lutils::compute_kernel PROPERTY LUTILS_SDK_INCLUDE_DIR
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
foreach(component IN ITEMS core erasure image image_memory compute_kernel compute compute_cpu)
    set(lutils_${component}_FOUND TRUE)
endforeach()
set(lutils_vulkan_FOUND @LUTILS_ENABLE_VULKAN@)
set(lutils_image_ops_FOUND @LUTILS_BUILD_IMAGE_OPS@)
set(lutils_kernelc_FOUND @LUTILS_BUILD_KERNELC@)
if(LUTILS_HOST_KERNELC)
    set(lutils_kernelc_FOUND FALSE)
    if(EXISTS "${LUTILS_HOST_KERNELC}" AND NOT IS_DIRECTORY "${LUTILS_HOST_KERNELC}" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/LutilsKernel.cmake")
        set(lutils_kernelc_FOUND TRUE)
    endif()
endif()
foreach(component IN LISTS lutils_FIND_COMPONENTS)
    if(component STREQUAL "vulkan" AND lutils_vulkan_FOUND)
        if(lutils_FIND_REQUIRED_vulkan)
            find_dependency(Vulkan)
        else()
            find_package(Vulkan QUIET)
        endif()
        if(Vulkan_FOUND)
            include("${CMAKE_CURRENT_LIST_DIR}/lutilsVulkanTargets.cmake")
        else()
            set(lutils_vulkan_FOUND FALSE)
        endif()
    elseif(component STREQUAL "image_ops" AND lutils_image_ops_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/lutilsImageOpsTargets.cmake")
    elseif(component STREQUAL "kernelc" AND lutils_kernelc_FOUND)
        if(NOT TARGET lutils::kernelc)
            if(LUTILS_HOST_KERNELC)
                add_executable(lutils::kernelc IMPORTED)
                set_target_properties(lutils::kernelc PROPERTIES IMPORTED_LOCATION "${LUTILS_HOST_KERNELC}")
            else()
                include("${CMAKE_CURRENT_LIST_DIR}/lutilsToolsTargets.cmake")
            endif()
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/LutilsKernel.cmake")
    endif()
    if(NOT lutils_${component}_FOUND)
        set(lutils_NOT_FOUND_MESSAGE "lutils component '${component}' is unavailable in this SDK or its dependencies are missing")
    endif()
endforeach()
check_required_components(lutils)
